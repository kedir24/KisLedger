.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Symbol files for native crash reporting
*.symbols

# Absolute paths or generated files
/android/app/debug/
/android/app/profile/
/android/app/release/

# ==========================================
# 2. Android Specific
# ==========================================
# Android Gradle build files & local properties
.gradle/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/captures/
**/android/.externalNativeBuild
**/android/.cxx/

# Android Studio / IntelliJ project files
*.iml
.idea/
.project
.classpath

# Native keystore files (Do NOT commit sensitive keys)
*.keystore
*.jks

